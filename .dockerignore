# Git
.git
.gitignore

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
.venv
venv/
ENV/
.eggs/
*.egg-info/
.pytest_cache/

# Node
node_modules/
remotion/node_modules/
render-service/node_modules/
dashboard/node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Video files (will be mounted via volume). `*.mp4` alone only matches the
# context root, so job folders are listed too: a self-host's output/ held
# 12 GB of clips and every build copied them all into the context.
*.mp4
*.avi
*.mov
*.mkv
*.gif
**/*.mp4
**/*.part
videos/
output/
uploads/

# Model files (downloaded at build time)
*.pt

# Runtime caches from the bind-mounted /app directory
.cache/

# Secrets — never bake real credentials into the image (repo is public,
# image may be pushed to a registry). Runtime env comes via compose env_file.
.env
.env.*
!.env.example
!.env.cloud.example
*.pem
*.key

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Docs
README.md
*.md








# Rust build output
osrender/target/
